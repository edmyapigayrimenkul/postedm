YOUTUBE_REFRESH_TOKEN=

# --- TIKTOK API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- GITHUB ACTIONS DISPATCH (Worker -> Repo) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=edmyapigayrimenkul/postedm
