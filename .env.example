# =========================================================
# EDM Yapı & Gayrimenkul — Sosyal Medya Botu (.env)
# =========================================================

# --- TELEGRAM BOT (Onay & Yönetim) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GOOGLE GEMINI (Metin, Başlık ve İçerik Üretimi) ---
GEMINI_API_KEY=
# Yedek anahtarlar (ayrı Google projesi = ayrı kota); sırayla denenir: GEMINI_API_KEY_YEDEK, GEMINI_API_KEY_YEDEK2
# Model zinciri src/generate_text.py › MODELLER içindedir (GEMINI_MODEL ortam değişkeni okunmaz).

# --- GÖRSEL & MEDYA HOSTING ---
# Öncelikli Barındırıcı: Cloudflare R2 Media CDN (S3 SigV4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edm-media
R2_PUBLIC_DOMAIN=media.edmyapigayrimenkul.com

# Yedek Barındırıcı (R2 tanımlı değilse otomatik devreye girer):
IMGBB_API_KEY=

# --- INSTAGRAM GRAPH API ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- FACEBOOK SAYFA API ---
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# --- THREADS API ---
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- YOUTUBE DATA API (Shorts) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TIKTOK API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- GITHUB ACTIONS DISPATCH (Worker -> Repo) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=edmyapigayrimenkul/postedm

# --- EDM SİTE İLAN KUYRUĞU ---
# Sitedeki POSTEDM_API_ANAHTARI ile aynı değer GitHub Secret olarak tanımlanır.
EDM_SITE_API_ANAHTARI=
EDM_SITE_KUYRUK_URL=https://edmyapigayrimenkul.com/api/postedm/kuyruk
